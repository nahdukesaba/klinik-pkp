# Klinik PKP - Example Environment
# Salin file ini menjadi `.env.local`, lalu isi sesuai environment Anda.

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------

# Wajib. Secret JWT untuk session admin frontend.
# Minimal 32 karakter. Gunakan nilai berbeda untuk production.
JWT_SECRET=ganti-dengan-secret-random-minimal-32-karakter

# ---------------------------------------------------------------------------
# Backend Server
# ---------------------------------------------------------------------------

# Wajib. Base URL backend API yang sedang aktif.
#
# Cara pindah server:
# 1. Pastikan server baru punya endpoint yang sama, misalnya /api/v1/faqs.
# 2. Ganti hanya nilai API_URL.
# 3. Restart aplikasi Next.js / redeploy production.
#
# Isi dengan server yang sedang aktif.
API_URL=https://ganti-dengan-domain-backend-anda.com/api/v1
#
# Contoh Cloudflare Tunnel:
# API_URL=https://rachel-standard-agree-extensive.trycloudflare.com/api/v1
#
# Contoh server IP lama:
# API_URL=http://103.197.190.87/api/v1
#
# Contoh domain production:
# API_URL=https://api.klinik-pkp.example.com/api/v1

# ---------------------------------------------------------------------------
# Authentication Backend
# ---------------------------------------------------------------------------

# Opsional. Full URL endpoint autentikasi backend.
# Isi jika login backend tidak memakai default /authentications.
# AUTH_API_URL=https://ganti-dengan-domain-backend-anda.com/api/v1/authentications

# Opsional. Path relatif endpoint autentikasi backend.
# Default frontend saat ini: /authentications
# AUTH_API_PATH=/authentications
