# ==============================================
# Klinik PKP - Environment Variables
# ==============================================
# COPY file ini menjadi .env.local dan isi dengan nilai yang benar.
# JANGAN PERNAH commit file .env.local ke git!
#
# File ini (.env.example) adalah TEMPLATE yang aman untuk di-commit.
# ==============================================

# ----- JWT Authentication -----
# Secret key untuk signing JWT tokens (minimal 32 karakter)
JWT_SECRET=ganti-dengan-secret-key-yang-sangat-panjang-dan-random

# ----- Internal API Key -----
# Key untuk memvalidasi internal API calls
INTERNAL_API_KEY=ganti-dengan-api-key-internal

# ----- Demo Login Credentials -----
# WAJIB diisi agar fitur login berfungsi.
# Jika tidak diisi, login endpoint akan menolak semua request (HTTP 503).
# Di production, ganti mekanisme demo ini dengan database query + bcrypt.
DEMO_USER_EMAIL=admin@klinikpkp.go.id
DEMO_USER_NIP=199001012020
DEMO_USER_PASSWORD=ganti-dengan-password-yang-kuat

# ----- External API Keys -----
# Simpan API keys untuk service external di sini
# JANGAN gunakan prefix NEXT_PUBLIC_ untuk API keys sensitif!
#
# Contoh:
# MAPS_API_KEY=your-google-maps-key
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# SMTP_API_KEY=your-sendgrid-key

# ----- Public Environment Variables -----
# Hanya gunakan NEXT_PUBLIC_ untuk nilai yang AMAN ditampilkan di browser
NEXT_PUBLIC_APP_NAME=Klinik PKP
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- API Configuration -----
# URL backend API (server-side only — TIDAK terexpose ke browser).
# Browser request melewati Next.js rewrite: /api/ext/* → API_URL/*
# sehingga URL backend TIDAK terlihat di browser inspect/network.
#
# PENTING: JANGAN gunakan prefix NEXT_PUBLIC_ untuk URL ini!
# NEXT_PUBLIC_ akan membuat nilai ini masuk ke client-side JavaScript
# dan terlihat di browser DevTools.
#
# Contoh untuk development lokal:
# API_URL=http://localhost:8000/api/v1
#
# Contoh untuk ngrok:
# API_URL=https://abc123.ngrok-free.dev/api/v1
API_URL=
